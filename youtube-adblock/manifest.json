{
  "manifest_version": 3,
  "name": "유튜브 광고 차단 (TechBridge)",
  "short_name": "YT 광고 차단",
  "version": "1.0.0",
  "description": "유튜브 영상 광고를 자동으로 건너뛰고, 배너·오버레이·피드 광고를 숨기는 가벼운 확장 프로그램.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://music.youtube.com/*",
    "*://www.youtube-nocookie.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yt_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "유튜브 광고 차단",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-adblock@techbridge.kr",
      "strict_min_version": "121.0"
    }
  }
}
