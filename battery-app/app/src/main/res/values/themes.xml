<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose가 모든 UI를 그리므로 시스템 테마는 액션바 없는 Material 기본만 쓴다.
         시스템바 아이콘 색은 BatteryTheme이 앱 테마에 맞춰 런타임에 정하므로 여기서 고정하지 않는다. -->
    <style name="Theme.Battery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
